        {
          "name": "B. ดูสินค้า",
          "item": [
            {
              "name": "Get All Products (เก็บ id อัตโนมัติ)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status 200', () => pm.response.to.have.status(200));",
                      "const list = pm.response.json().data || [];",
                      "const map = { penId: 'ปากกาลูกลื่น สีน้ำเงิน', notebookId: 'สมุดโน้ต A5', highlighterId: 'ไฮไลท์ สีเหลือง', fileId: 'แฟ้มเอกสาร A4', calcId: 'เครื่องคิดเลข' };",
                      "Object.entries(map).forEach(([v, name]) => {",
                      "  const p = list.find((x) => x.name === name);",
                      "  pm.test(`พบสินค้า ${name}`, () => pm.expect(p, 'ยังไม่ได้รัน npm run seed:data').to.exist);",
                      "  if (p) pm.collectionVariables.set(v, p._id);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
